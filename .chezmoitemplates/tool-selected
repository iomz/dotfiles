{{- /* Renders "true" when tool entry .tool applies to the host in .data.
       Optional .os also applies that OS table's own arch filter. */ -}}
{{- $tool := .tool -}}
{{- $data := .data -}}
{{- $os := get . "os" | default "" -}}
{{- $host := get $data "host" | default "" -}}
{{- $selected := true -}}
{{- if hasKey $tool "hosts" -}}
{{-   $selected = has $host $tool.hosts -}}
{{- else if hasKey $tool "groups" -}}
{{-   $hostGroups := list -}}
{{-   if hasKey $data.hosts $host -}}
{{-     $hostGroups = get (index $data.hosts $host) "groups" | default list -}}
{{-   end -}}
{{-   $selected = false -}}
{{-   range $tool.groups -}}
{{-     if has . $hostGroups }}{{ $selected = true }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- if and $selected (hasKey $tool "arch") -}}
{{-   $selected = has $data.chezmoi.arch $tool.arch -}}
{{- end -}}
{{- if and $selected $os (hasKey $tool $os) -}}
{{-   $osTable := index $tool $os -}}
{{-   if hasKey $osTable "arch" -}}
{{-     $selected = has $data.chezmoi.arch $osTable.arch -}}
{{-   end -}}
{{- end -}}
{{- if $selected }}true{{ end -}}
