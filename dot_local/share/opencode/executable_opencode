#!/usr/bin/env bash
set -e

ROOT="${OPENCODE_DATA_HOME:-$HOME/.local/share/opencode}"
if [[ -x "$ROOT/active/opencode" ]]; then
  exec "$ROOT/active/opencode" "$@"
fi
if [[ -x "$ROOT/active" ]]; then
  exec "$ROOT/active" "$@"
fi

printf 'opencode: active executable missing under %s\n' "$ROOT" >&2
exit 127
