#!/usr/bin/env bash
set -Eeuo pipefail

STATUSLINE="$HOME/.local/bin/claude-code-status-line.py"
# APM deploys Caveman as a native Claude Code plugin.
CAVEMAN_DIR="$HOME/.agents/plugins/caveman"
CAVEMAN="$CAVEMAN_DIR/src/hooks/caveman-statusline.sh"
input=$(cat)
# Renders the given segments; an empty list keeps the script's defaults.
render() {
  if [[ -n $1 ]]; then
    printf '%s' "$input" | SL_SEGMENTS=$1 "$STATUSLINE"
  else
    printf '%s' "$input" | "$STATUSLINE"
  fi
}

# Caveman's mode for this session, right after the model segment so Claude
# Code does not cut it off: [Caveman v4.2.0]. The row below belongs to Claude
# Code itself, so everything stays on one row.
row=
if [[ -r $CAVEMAN ]]; then
  # The badge script reads the session id from the same JSON and prints a
  # colored [CAVEMAN], [ULTRACAVE], [CAVEMAN:COMMIT] and so on.
  badge=$(printf '%s' "$input" | bash "$CAVEMAN" 2>/dev/null || true)
  badge=$(printf '%s' "$badge" | sed -e $'s/\033\\[[0-9;]*m//g' -e 's/^\[//' -e 's/\]$//')
  if [[ $badge =~ ^[A-Z][A-Z:]{0,31}$ ]]; then
    # Capitalized like the project name: Caveman, Ultracave, Caveman:commit.
    name=${badge:0:1}$(printf '%s' "${badge:1}" | tr '[:upper:]' '[:lower:]')
    version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$CAVEMAN_DIR/.claude-plugin/plugin.json" 2>/dev/null | head -n 1 || true)
    [[ $version =~ ^[0-9A-Za-z.+-]{1,32}$ ]] || version=
    row=$(printf '\033[38;5;172m[%s%s]\033[0m' "$name" "${version:+ v$version}")
  fi
fi

# Split SL_SEGMENTS after `model`, the segment the badge follows; without a
# model segment the badge leads the row.
segments=${SL_SEGMENTS:-}
if [[ -z $row ]]; then
  render "$segments"
elif [[ " $segments " == *" model "* ]]; then
  before=${segments%%model*}model
  after=${segments#*model}
  after=${after# }
  first=$(render "$before")
  # Extra rows such as the update notice stay below the status row.
  extra=
  if [[ $first == *$'\n'* ]]; then
    extra=${first#*$'\n'}
    first=${first%%$'\n'*}
  fi
  rest=
  # The first call already printed any update notice.
  [[ -z $after ]] || rest=$(SL_SHOW_STATUSLINE_UPDATE=0 render "$after")
  rest=${rest%%$'\n'*}
  rest=${rest#"${rest%%[! ]*}"}
  printf '%s %s%s\n' "$first" "$row" "${rest:+  $rest}"
  [[ -z $extra ]] || printf '%s\n' "$extra"
else
  line=$(render "$segments")
  printf '%s  %s\n' "$row" "${line#"${line%%[! ]*}"}"
fi
