{{- /* Without jq the script renders empty, so the apply goes on and a later
     apply runs it once the package install has added jq. */ -}}
{{ if and (eq (includeTemplate "is-stem" .) "true") (lookPath "jq") -}}
#!/bin/sh
# Points Claude Code's status line at the managed wrapper, which holds the
# layout. Only the statusLine keys are written: APM and Claude Code own the
# rest of settings.json, so the file itself stays out of chezmoi.
# Runs again whenever this script changes.
set -eu

settings="$HOME/.claude/settings.json"
command="$HOME/.local/bin/claude-code-status-line"

mkdir -p "$HOME/.claude"
if [ ! -s "$settings" ]; then
    (umask 077 && printf '{}\n' > "$settings")
fi
# Replace the file a link points to, not the link.
if [ -L "$settings" ]; then
    settings=$(realpath "$settings")
fi
tmp=$(mktemp "$settings.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# Start from a copy so the new file keeps the old one's mode, then rename it
# over the old file: an interrupted run leaves settings.json unchanged.
cp -p "$settings" "$tmp"
jq --arg command "$command" \
    '.statusLine.type = "command" | .statusLine.command = $command' "$settings" > "$tmp"
mv "$tmp" "$settings"
echo "claude-status-line: $settings uses $command"
{{ end -}}
