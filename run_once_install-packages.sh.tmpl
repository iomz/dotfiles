{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# apt packages selected for this host from .chezmoidata/tools.toml.
{{- $packages := list }}
{{- range $name, $tool := .tools }}
{{-   if and (hasKey $tool "linux") (hasKey $tool.linux "apt") (eq (includeTemplate "tool-selected" (dict "tool" $tool "data" $ "os" "linux")) "true") }}
{{-     $packages = append $packages $tool.linux.apt }}
{{-   end }}
{{- end }}
wanted="
  {{ join "\n  " $packages }}
"

# Touch apt (and sudo) only for packages that are not installed yet.
installed=$(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 2>/dev/null | awk '$1 == "ii" { print $2 }')
missing=
for package in $wanted; do
  printf '%s\n' "$installed" | grep -qx "$package" || missing="$missing $package"
done
if [ -n "$missing" ]; then
  sudo apt update
  # shellcheck disable=SC2086 # word splitting is intended
  sudo apt install -y $missing
fi

# Release upgrades disable third-party sources; re-enable mise's when needed.
mise_source=/etc/apt/sources.list.d/extrepo_mise.sources
if [ ! -f "$mise_source" ] || grep -qi '^Enabled: *no' "$mise_source"; then
  sudo extrepo enable mise
fi
if ! command -v mise >/dev/null 2>&1; then
  sudo apt update
  sudo apt install -y mise
fi

{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Homebrew formulae and casks selected for this host from .chezmoidata/tools.toml.
{{- $formulae := list }}
{{- range $name, $tool := .tools }}
{{-   if and (hasKey $tool "darwin") (hasKey $tool.darwin "brew") (eq (includeTemplate "tool-selected" (dict "tool" $tool "data" $ "os" "darwin")) "true") }}
{{-     $formulae = append $formulae $tool.darwin.brew }}
{{-   end }}
{{- end }}
wanted="
  {{ join "\n  " $formulae }}
"

# Call brew only for missing names (canonical names, not aliases), so nothing
# already installed is checked, warned about or upgraded.
installed=$(brew list -1 --formula 2>/dev/null; brew list -1 --cask 2>/dev/null)
missing=
for formula in $wanted; do
  printf '%s\n' "$installed" | grep -qx "$formula" || missing="$missing $formula"
done
if [ -n "$missing" ]; then
  # shellcheck disable=SC2086 # word splitting is intended
  HOMEBREW_NO_INSTALL_UPGRADE=1 brew install $missing
fi
{{ end -}}
