{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

{{ includeTemplate "brew-path" . }}
# Linux packages selected for this host from .chezmoidata/tools.toml, one
# "<apt name> <brew name>" pair per tool ("-" where none is declared).
{{- $pairs := list }}
{{- range $name, $tool := .tools }}
{{-   if and (hasKey $tool "linux") (or (hasKey $tool.linux "apt") (hasKey $tool.linux "brew")) (eq (includeTemplate "tool-selected" (dict "tool" $tool "data" $ "os" "linux")) "true") }}
{{-     $pairs = append $pairs (printf "%s %s" (get $tool.linux "apt" | default "-") (get $tool.linux "brew" | default "-")) }}
{{-   end }}
{{- end }}
pairs="
{{ join "\n" $pairs }}
"

# apt is preferred where this user can run it; Homebrew covers tools without
# an apt package and hosts without apt or root. Only missing packages are
# installed.
has_apt=$(command -v apt-get >/dev/null 2>&1 && echo yes || true)
has_brew=$(command -v brew >/dev/null 2>&1 && echo yes || true)
apt_installed=$( [ -n "$has_apt" ] && dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' 2>/dev/null | awk '$1 == "ii" { print $2 }' || true)
brew_installed=$( [ -n "$has_brew" ] && brew list -1 --formula 2>/dev/null || true)
apt_missing=
brew_missing=
skipped=

# Ask at most once, and only when something needs root. `sudo -n` alone is not
# enough: it also fails where sudo would accept a password, so prompt on a TTY.
root=
can_root() {
  if [ -z "$root" ]; then
    root=no
    if [ "$(id -u)" = 0 ]; then
      root=self
    elif command -v sudo >/dev/null 2>&1; then
      if sudo -n true 2>/dev/null || { [ -t 0 ] && sudo -v; }; then
        root=sudo
      fi
    fi
  fi
  [ "$root" != no ]
}
as_root() {
  if [ "$root" = self ]; then "$@"; else sudo "$@"; fi
}

# The list comes in on fd 3, leaving stdin to the sudo prompt.
while read -r apt_name brew_name <&3; do
  [ -n "$apt_name" ] || continue
  if [ "$apt_name" != - ] && printf '%s\n' "$apt_installed" | grep -qx "$apt_name"; then
    continue
  elif [ "$apt_name" != - ] && [ -n "$has_apt" ] && can_root; then
    apt_missing="$apt_missing $apt_name"
  elif [ "$brew_name" != - ] && [ -n "$has_brew" ]; then
    printf '%s\n' "$brew_installed" | grep -qx "$brew_name" || brew_missing="$brew_missing $brew_name"
  else
    if [ "$apt_name" != - ]; then skipped="$skipped $apt_name"; else skipped="$skipped $brew_name"; fi
  fi
done 3<<EOF_PAIRS
$pairs
EOF_PAIRS
# One unknown name fails a whole apt or brew install, as on an older release
# that lacks a package, so install only names the manager knows.
unknown=
if [ -n "$apt_missing" ]; then
  as_root apt update
  known=
  for name in $apt_missing; do
    # apt translates its labels, so read them in the C locale.
    if LC_ALL=C apt-cache policy "$name" 2>/dev/null | grep -q '^ *Candidate: [^(]'; then
      known="$known $name"
    else
      unknown="$unknown $name"
    fi
  done
  # shellcheck disable=SC2086 # word splitting is intended
  [ -z "$known" ] || as_root apt install -y $known
fi
if [ -n "$brew_missing" ]; then
  known=
  for name in $brew_missing; do
    if brew info "$name" >/dev/null 2>&1; then known="$known $name"; else unknown="$unknown $name"; fi
  done
  # shellcheck disable=SC2086 # word splitting is intended
  [ -z "$known" ] || HOMEBREW_NO_INSTALL_UPGRADE=1 brew install $known
fi
# en_US.UTF-8 is the locale everywhere: generate it, since bash and perl warn
# about a missing one, and make it the system default for logins and services.
if command -v locale-gen >/dev/null 2>&1; then
  if ! locale -a 2>/dev/null | grep -qix 'en_US\.utf-\{0,1\}8'; then
    if can_root; then
      # Debian generates only what /etc/locale.gen lists; Ubuntu takes the name.
      [ ! -f /etc/locale.gen ] || as_root sed -i 's/^# *\(en_US\.UTF-8 UTF-8\)$/\1/' /etc/locale.gen
      as_root locale-gen en_US.UTF-8 >/dev/null || echo 'install-packages: could not generate en_US.UTF-8' >&2
    else
      skipped="$skipped en_US.UTF-8"
    fi
  fi
  if ! grep -Eq '^LANG="?en_US\.UTF-8"?$' /etc/default/locale 2>/dev/null && can_root; then
    as_root update-locale LANG=en_US.UTF-8 || echo 'install-packages: could not set the system locale' >&2
  fi
fi
{{ if eq (includeTemplate "selects-mise" .) "true" -}}
# Release upgrades disable third-party sources; re-enable mise's when needed.
if [ -n "$has_apt" ]; then
  mise_source=/etc/apt/sources.list.d/extrepo_mise.sources
  if [ ! -f "$mise_source" ] || grep -qi '^Enabled: *no' "$mise_source"; then
    if command -v extrepo >/dev/null 2>&1 && can_root; then
      as_root extrepo enable mise || echo 'install-packages: could not enable the mise apt source' >&2
    fi
  fi
fi
if ! command -v mise >/dev/null 2>&1; then
  # Falls through to Homebrew or the report when apt cannot provide mise.
  if [ -n "$has_apt" ] && can_root && as_root apt update && as_root apt install -y mise; then
    :
  elif [ -n "$has_brew" ]; then
    HOMEBREW_NO_INSTALL_UPGRADE=1 brew install mise
  else
    skipped="$skipped mise"
  fi
fi
{{ end -}}
if [ -n "$unknown" ]; then
  printf 'install-packages: skipped (unknown to the package manager):%s\n' "$unknown" >&2
fi
if [ -n "$skipped" ]; then
  printf 'install-packages: skipped (no usable package manager):%s\n' "$skipped" >&2
  # A run_once script is not retried after it succeeds.
  printf '%s\n' 'install-packages: to retry later: sh -c "$(chezmoi cat ~/install-packages.sh)"' >&2
fi

{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

{{ includeTemplate "brew-path" . }}
# Homebrew formulae and casks selected for this host from .chezmoidata/tools.toml.
{{- $formulae := list }}
{{- $casks := list }}
{{- range $name, $tool := .tools }}
{{-   if and (hasKey $tool "darwin") (eq (includeTemplate "tool-selected" (dict "tool" $tool "data" $ "os" "darwin")) "true") }}
{{-     if hasKey $tool.darwin "brew" }}{{ $formulae = append $formulae $tool.darwin.brew }}{{ end }}
{{-     if hasKey $tool.darwin "cask" }}{{ $casks = append $casks $tool.darwin.cask }}{{ end }}
{{-   end }}
{{- end }}
formulae="
  {{ join "\n  " $formulae }}
"
casks="
  {{ join "\n  " $casks }}
"

# shellcheck disable=SC2086 # word splitting is intended
set -- $formulae $casks
if ! command -v brew >/dev/null 2>&1; then
  if [ $# -gt 0 ]; then
    printf 'install-packages: skipped (no usable package manager):%s\n' "$(printf ' %s' "$@")" >&2
    # A run_once script is not retried after it succeeds.
    printf '%s\n' 'install-packages: to retry later: sh -c "$(chezmoi cat ~/install-packages.sh)"' >&2
  fi
  exit 0
fi

# Call brew only for missing names (canonical names, not aliases), so nothing
# already installed is checked, warned about or upgraded. A tap-qualified name
# such as owner/tap/name is listed under its last part.
installed_formulae=$(brew list -1 --formula 2>/dev/null || true)
installed_casks=$(brew list -1 --cask 2>/dev/null || true)
missing=
unknown=
for formula in $formulae; do
  printf '%s\n' "$installed_formulae" | grep -qx "${formula##*/}" && continue
  # One unknown name fails the whole brew install; brew install taps a
  # tap-qualified name itself, so only plain names are checked.
  case $formula in
    */*) missing="$missing $formula" ;;
    *) if brew info --formula "$formula" >/dev/null 2>&1; then missing="$missing $formula"; else unknown="$unknown $formula"; fi ;;
  esac
done
# Apps install first, since a formula may need one (sshfs-mac needs macfuse),
# and one by one: some installers ask for the password, and one failure must
# not stop the rest.
failed=
for cask in $casks; do
  printf '%s\n' "$installed_casks" | grep -qx "${cask##*/}" && continue
  if ! brew info --cask "$cask" >/dev/null 2>&1; then
    unknown="$unknown $cask"
  elif ! HOMEBREW_NO_INSTALL_UPGRADE=1 brew install --cask "$cask"; then
    failed="$failed $cask"
  fi
done
if [ -n "$missing" ]; then
  # shellcheck disable=SC2086 # word splitting is intended
  HOMEBREW_NO_INSTALL_UPGRADE=1 brew install --formula $missing
fi
if [ -n "$unknown" ]; then
  printf 'install-packages: skipped (unknown to Homebrew):%s\n' "$unknown" >&2
fi
if [ -n "$failed" ]; then
  printf 'install-packages: failed:%s\n' "$failed" >&2
  printf '%s\n' 'install-packages: to retry later: sh -c "$(chezmoi cat ~/install-packages.sh)"' >&2
fi
{{ end -}}
