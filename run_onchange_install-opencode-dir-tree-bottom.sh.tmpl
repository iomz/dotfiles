#!/bin/sh
set -eu

# dependency-lock: {{ include "dot_config/opencode/cli-plugins/dir-tree-bottom/package-lock.json" | sha256sum }}
plugin_dir="{{ .chezmoi.homeDir }}/.config/opencode/cli-plugins/dir-tree-bottom"
if ! command -v npm >/dev/null 2>&1; then
  echo "npm is required to install dir-tree-bottom dependencies" >&2
  exit 1
fi
npm ci --prefix "$plugin_dir" --ignore-scripts --no-audit --no-fund
