#autoload

# cd ${0%/*}

zdir=$ZDOTDIR
[[ -d $zdir ]] || zdir=${XDG_CONFIG_HOME}/zsh
ZDOTDIR=$zdir

# Refresh commands list from PATH in current shell
rehash

_zsh_compile_if_writable() {
    local target=$1 tmp=$1.$$.zwc
    # Avoid noisy zcompile failures in readonly or sandboxed startup contexts.
    [[ -s $target && -w ${target:h} ]] || return
    # Rename a finished digest into place: zcompile writes in place, and a
    # shell starting meanwhile could read a partial one.
    zcompile $tmp $target && mv -f $tmp $target.zwc || rm -f $tmp
}

# zsh reads file.zwc in place of a startup or sourced file only when it is
# that file's own compiled form and newer, so compile each file separately.
local f
for f in ~/.zshenv ~/.zprofile $zdir/.zshrc $zdir/.zlogin $zdir/rc.d/<->-*zsh(N-.); do
    _zsh_compile_if_writable $f
done

# Compile the completion dump
zcd=$zdir/.zcompdump
if [[ ! -s ${zcd}.zwc || $zcd -nt ${zcd}.zwc ]]; then _zsh_compile_if_writable $zcd; fi
