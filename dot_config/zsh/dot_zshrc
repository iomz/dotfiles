#!/usr/bin/env zsh

#------------------------------------
# start zprof
[[ -z "$ZPROF" ]] || zmodload zsh/zprof
#------------------------------------
# zproftime
## diagnose afterward: `zproftime-sort /tmp/zproftime.* | head`
if [[ -n "${ENABLE_ZPROFTIME}" ]]; then
    zmodload zsh/datetime
    setopt PROMPT_SUBST
    PS4='+$EPOCHREALTIME %N:%i> '
    logfile=$(mktemp /tmp/zproftime.XXXX)
    exec 3>&2 2>$logfile
    setopt XTRACE
fi
#------------------------------------

# rc.d
local ZDOTDIR=${XDG_CONFIG_HOME}/zsh
for f in ${ZDOTDIR}/rc.d/<->-*zsh(N); do
    #print -- "$f"
    source "$f"
done

# Editor
# SUDO_EDITOR must be absolute: classic sudo silently opens the system editor
# for a bare name, even one on PATH.
for editor in nvim vim vim.tiny vi; do
    editor_path=$(whence -p "$editor") || continue
    # A mise shim can exist without an active version.
    [[ "$editor" != nvim ]] || "$editor_path" --version > /dev/null 2>&1 || continue
    export EDITOR=$editor VISUAL=$editor SUDO_EDITOR=$editor_path
    # Deleted or yanked lines of root-only files must not reach shada or viminfo.
    # sudo-rs splits on every space: keep them single.
    [[ "$editor" == vi ]] || SUDO_EDITOR+=" -i NONE"
    break
done
unset editor editor_path

# Pager
export PAGER=less
#export PAGER=most

#------------------------------------
# zproftime end
if [[ -n "${ENABLE_ZPROFTIME}" ]]; then
    unsetopt XTRACE
    exec 2>&3 3>&-
fi
#------------------------------------
# end zprof
[[ -z "$ZPROF" ]] || zprof | $PAGER
#------------------------------------

############### -------------

# source local if non-empty files exist (should not be managed by chezmoi)
if [[ -s ~/.zprofile ]]; then
    source ~/.zprofile
fi
