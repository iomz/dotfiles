# Create and open a temporary Markdown scratch file,
# import the clipboard with -c, or reveal the latest scratch with -r.
local dir file editor ret

if [[ "$1" == "-r" ]]; then
    if [[ -z "${SCRATCH:-}" || ! -e "$SCRATCH" ]]; then
        print -u2 -- "scratch: no scratch file available"
        return 1
    fi

    open -R "$SCRATCH"
    return $?
fi

dir="$(mktemp -d "${${TMPDIR:-/tmp}%/}/scratch.XXXXXX")" || return
file="$dir/scratch.md"

if [[ "$1" == "-c" ]]; then
    pbpaste >| "$file" || return
    typeset -g SCRATCH="$file"
    print -r -- "scratch: $SCRATCH"
    open -R "$SCRATCH"
    return $?
fi

: >| "$file" || return

editor="${EDITOR:-nvim}"
print -r -- "scratch: $file"

${(z)editor} "$file"
ret=$?

typeset -g SCRATCH="$file"
print -r -- "scratch saved at: $SCRATCH"

return "$ret"
