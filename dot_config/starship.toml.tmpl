add_newline = true
continuation_prompt = '▶▶ '

# Optional project information must not hold up the prompt.
scan_timeout = 10
command_timeout = 100
follow_symlinks = false

# Use custom format
format = "$all$character"

[directory]
truncation_length = 10
truncate_to_repo = false

[hostname]
format = "@[$hostname]($style):"
style = "bold fg:{{ includeTemplate "host-color" . | default "bright-blue" }}"
ssh_only = false

[time]
disabled = false
format = "[$time]($style) "

[username]
format = "[$user]($style)"
style_user = "bold red"
show_always = true
