{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cmux-transparent",
    "mode": "dark"
  },
  "session": {
    "scrollbar": true,
    "tps": true
  },
  "keybinds": {
    "command.palette.show": "<leader>p",
    "input.move.up": "up,ctrl+p",
    "input.move.down": "down,ctrl+n",
    "input.move.left": "left,ctrl+b",
    "input.delete.to.line.end": "ctrl+k"
  },
  "plugins": [
    "-opencode.sidebar.context",
    "{{ .chezmoi.homeDir }}/.config/opencode/cli-plugins/codex-quota-sidebar",
    {
      "package": "{{ .chezmoi.homeDir }}/.config/opencode/cli-plugins/sidebar-dashboard",
      "options": {
        "context": true,
        "usage": true,
        "session": true,
        "tokens": true,
        "activity": true,
        "workers": true,
        "colors": {
          "heading": "#5394ee",
          "muted": "#a6b2c0",
          "positive": "#32cd99",
          "warning": "#e5c07b",
          "critical": "#ff4747"
        }
      }
    },
    {
      "package": "opencode-git-plugin@0.3.0",
      "options": { "intervalMs": 8000, "folderTree": "compact" }
    },
    "{{ .chezmoi.homeDir }}/.config/opencode/cli-plugins/dir-tree-bottom"
  ]
}
