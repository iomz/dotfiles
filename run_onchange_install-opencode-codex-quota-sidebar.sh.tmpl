#!/bin/sh
set -eu

# Reinstall when pinned plugin dependencies change.
# dependency-lock: {{ include "dot_config/opencode/cli-plugins/codex-quota-sidebar/package-lock.json" | sha256sum }}

plugin_dir="{{ .chezmoi.homeDir }}/.config/opencode/cli-plugins/codex-quota-sidebar"

if ! command -v npm >/dev/null 2>&1; then
  echo "npm is required to install codex-quota-sidebar dependencies" >&2
  exit 1
fi

npm ci --prefix "$plugin_dir" --ignore-scripts --no-audit --no-fund
