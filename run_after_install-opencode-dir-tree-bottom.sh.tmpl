{{- $lockHash := include "dot_config/opencode/cli-plugins/dir-tree-bottom/package-lock.json" | sha256sum -}}
{{- $pluginDir := joinPath .chezmoi.destDir ".config/opencode/cli-plugins/dir-tree-bottom" -}}
{{- $stamp := joinPath $pluginDir "node_modules/.chezmoi-lock-sha256" -}}
{{- /* Installed and matching the lock: render nothing, so chezmoi neither runs
     the script nor lists it. A later loss of node_modules renders it again. */ -}}
{{- $current := and (stat $stamp) (stat (joinPath $pluginDir "node_modules/opencode-dir-tree-tui/package.json")) (eq (include $stamp | trim) $lockHash) -}}
{{ if and (eq (includeTemplate "tool-selected" (dict "tool" .tools.node "data" .)) "true") (not $current) -}}
#!/bin/sh
set -eu

lock_hash="{{ $lockHash }}"
plugin_dir="{{ $pluginDir }}"
stamp="$plugin_dir/node_modules/.chezmoi-lock-sha256"
if ! command -v mise >/dev/null 2>&1; then
    echo "mise is required to install dir-tree-bottom dependencies" >&2
    exit 1
fi

# Bootstrap Node before the full mise installer; ignore inherited asdf shims.
node_version="{{ .tools.node.mise }}"
mise install "node@$node_version"
mise exec "node@$node_version" -- npm ci --prefix "$plugin_dir" --ignore-scripts --no-audit --no-fund
printf '%s\n' "$lock_hash" > "$stamp"
{{ end -}}
