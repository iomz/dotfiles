" Plain Vim, no plugins. Dev hosts use Neovim; this is the editor everywhere else.
" vim-tiny has no +eval and skips `if` blocks, so anything needing it goes there.
set nocompatible

" Files
set autoread
set hidden
set modeline
set fileformats=unix,dos,mac
set fileencodings=ucs-bom,utf-8,iso-2022-jp,euc-jp,cp932,latin1

" Indentation
set autoindent
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4
set backspace=indent,eol,start

" Display and search; silent! covers options missing from vim-tiny
set number
set wrap
set display=lastline
set laststatus=2
set scrolloff=10
set ignorecase
set smartcase
silent! set cursorline
silent! set hlsearch
silent! set matchtime=1
silent! set pumheight=10
silent! set showcmd
silent! set showmatch
silent! set smarttab
silent! set title
silent! syntax on
silent! filetype plugin indent on
" habamax ships with Vim 9; older Vims keep the default colors.
silent! colorscheme habamax

" Keys
nnoremap Y y$
nnoremap + <C-a>
nnoremap - <C-x>
inoremap <C-b> <Left>
inoremap <C-n> <Down>
inoremap <C-p> <Up>
inoremap <C-f> <Right>

if 1
  " Keep backup and swap files out of the working directory.
  let s:state = (empty($XDG_STATE_HOME) ? expand('~/.local/state') : expand($XDG_STATE_HOME)) . '/vim'
  " sudo keeps HOME on macOS: root must not create directories in a user's home.
  let s:sudo_root = $USER ==# 'root' && !empty($SUDO_USER)
  if !s:sudo_root
    for s:dir in ['backup', 'swap']
      if !isdirectory(s:state . '/' . s:dir)
        silent! call mkdir(s:state . '/' . s:dir, 'p', 0700)
      endif
    endfor
    if filewritable(s:state . '/backup') == 2
      execute 'set backupdir=' . fnameescape(s:state . '/backup//')
      set backup
    endif
    if filewritable(s:state . '/swap') == 2
      execute 'set directory=' . fnameescape(s:state . '/swap//')
    endif
  endif
  " sudoedit works on copies of root-owned files; do not keep backups of them.
  set backupskip+=/tmp/*,/var/tmp/*,/private/tmp/*,/private/var/tmp/*,/dev/shm/*

  augroup vimrc
    autocmd!
    autocmd BufNewFile,BufRead *.conf,*.md,*.rb,*.xml setlocal tabstop=2 shiftwidth=2 softtabstop=2
    autocmd SwapExists * let v:swapchoice = 'o'
  augroup END
endif
