{{ if ne (get . "variant" | default "workstation") "claude-cloud" -}}
{{- $config := "" -}}
{{- range glob (joinPath .chezmoi.sourceDir "dot_config/nvim/**") -}}
{{-   if not (stat .).isDir }}{{ $config = print $config . "\n" (include .) }}{{ end -}}
{{- end -}}
#!/bin/sh
# Sync Neovim plugins whenever the managed config changes. Best effort: a failed
# plugin update does not fail the apply; rerun :Lazy sync to retry.
# chezmoi trigger: {{ $config | sha256sum }}
set -eu

nvim=$(command -v nvim 2>/dev/null || mise which nvim 2>/dev/null || true)
if [ -z "$nvim" ]; then
    exit 0
fi
"$nvim" --headless "+Lazy! sync" +qa
{{ end -}}
