{{- $variant := includeTemplate "variant" (dict "variant" (env "CHEZMOI_VARIANT" | default (get . "variant"))) -}}
{{- if not (has $variant (list "helm" "agent-sandbox")) -}}
{{- fail "CHEZMOI_VARIANT must be helm or agent-sandbox" -}}
{{- end -}}
{{- $host := env "CHEZMOI_HOST" | default .chezmoi.hostname -}}
{{- if eq $variant "agent-sandbox" }}
[data]
variant = "agent-sandbox"
host = {{ $host | quote }}
{{- else -}}
{{- $host = promptStringOnce . "host" "Host profile" $host -}}
{{- $gitName := promptStringOnce . "git_name" "Git author name" "Iori Mizutani" -}}
{{- $gitEmail := promptStringOnce . "git_email" "Git author email" "iomz@sazanka.io" -}}

[data]
variant = "helm"
host = {{ $host | quote }}
git_name = {{ $gitName | quote }}
git_email = {{ $gitEmail | quote }}
{{- end }}
